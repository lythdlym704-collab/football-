name: Build APK
on:
  push:
    branches: [main, master]
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - run: npm install
      - name: Prepare web files
        run: |
          mkdir -p www
          cp index.html www/index.html
          cp node_modules/three/build/three.min.js www/three.min.js
          npx esbuild shim.src.js --bundle --minify --format=iife --outfile=www/shim.js
      - name: Create Android project
        run: |
          echo '{"appId":"com.football.game","appName":"Football Game","webDir":"www"}' > capacitor.config.json
          npx cap add android
          npx cap sync android
      - name: Build debug APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: football-game-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
